// KimiOS: administrators of this computer (group wheel) may mount its internal drives from their own session
// without a password, as they can removable ones. KimiLM mounts the drive a model file is on (KimiLM 2.23.0),
// and the KimiOS session has no password prompt to show. Unlocking encrypted drives still asks.
polkit.addRule(function (action, subject) {
  if ((action.id == "org.freedesktop.udisks2.filesystem-mount-system" ||
       action.id == "org.freedesktop.udisks2.filesystem-mount") &&
      subject.local && subject.active && subject.isInGroup("wheel")) {
    return polkit.Result.YES;
  }
});
