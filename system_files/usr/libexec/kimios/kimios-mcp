def tool_logs(scope="user", unit="", lines=50, priority="warning"):
    lines = max(1, min(int(lines or 50), 300))
    cmd = ["journalctl", "--no-pager", "-o", "short-iso", "-n", str(lines)]
    if scope == "user":
        cmd.append("--user")
    if unit:
        cmd += ["-u", unit] if scope != "user" else ["--user-unit", unit]
    if priority:
        cmd += ["-p", priority]
    code, out, err = run(cmd, timeout=20)
    if code != 0 and not out:
        raise ToolError(err.strip()[:200])
    return {"lines": out.splitlines()[-lines:]}


def _gv(text):
    """A GVariant string literal, so gdbus never reads a title such as "true" as another type."""
    return "'" + str(text).replace("\\", "\\\\").replace("'", "\\'") + "'"


def tool_notify(title, body=""):
    code, _, err = run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                        "--object-path", "/org/freedesktop/Notifications", "--method",
                        "org.freedesktop.Notifications.Notify", _gv("KimiOS"), "0", _gv("kimilm"), _gv(title),
                        _gv(body), "[]", "{}", "-1"])
    if code != 0:
        raise ToolError(err.strip()[:200] or "no notification service")
    return {"shown": title}


