    env = _envelope()
    try:
        return env.request(req, Path(os.environ.get("KIMIOS_ENVELOPE_SOCKET", str(env.SOCKET))), timeout)
    except env.EnvelopeError as exc:
        raise ToolError(str(exc)) from None


def _sim_control(req):
    path = Path(os.environ.get("KIMIOS_SIM_DIR", "/run/kimios-sim")) / "control.sock"
    import socket as _socket
    with _socket.socket(_socket.AF_UNIX, _socket.SOCK_STREAM) as s:
        s.settimeout(10)
        try:
            s.connect(str(path))
        except OSError as exc:
            raise ToolError(f"the simulated bench is not running ({exc}): systemctl status kimi-simbench") from None
        s.sendall((json.dumps(req) + "\n").encode())
        out = json.loads(s.makefile().readline() or "{}")
    if not out.get("ok"):
        raise ToolError(out.get("error") or "the bench refused")
    return out


def tool_bench(device=None, send=None):
    if not device:
        rows = _ask({"op": "devices"})["devices"]
        return {"devices": rows, "next": "bench(device=<id>) for its datasheet, driver and state"}
    if send:
        text = str(send).strip()
        if not (text.endswith("?") or text.upper() in ("HELP", "ID?", "*IDN?", "READ")):
            raise ToolError("bench only sends questions (commands ending in ?, HELP, READ); outputs are set by "
                            "controller or bench_experiment, through the guard")
        return {"sent": text, "reply": _ask({"op": "probe", "device": device, "text": text})["reply"]}
    out = _ask({"op": "device", "device": device})
    st = out["status"]
    if out["driver"]["current"] is None:
        st["next"] = ("No driver yet: read the datasheet, send HELP (bench send='HELP'), write a manifest "
                      "{read: [{command, pattern with (?P<sensor>…) groups}], write: {output: {command with {value}, "
                      "ok}}} and try it with driver(action='test').")
    return out


