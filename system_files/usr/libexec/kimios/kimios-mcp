# ------------------------------------------------------------------------------------------------- protocol
def handle(msg):
    """One JSON-RPC message in, the reply out (None for notifications)."""
    method, mid = msg.get("method"), msg.get("id")
    if mid is None:
        return None                                       # notifications: initialized, cancelled…
    try:
        if method == "initialize":
            params = msg.get("params") or {}
            result = {"protocolVersion": params.get("protocolVersion") or "2025-06-18",
                      "capabilities": {"tools": {"listChanged": False}},
                      "serverInfo": {"name": "kimios", "title": "KimiOS", "version": VERSION},
                      "instructions": INSTRUCTIONS}
        elif method == "ping":
            result = {}
        elif method == "tools/list":
            result = {"tools": [{"name": n, "description": d, "inputSchema": s, "annotations": a}
                                for n, (_, d, s, a) in TOOLS.items()]}
        elif method == "tools/call":
            params = msg.get("params") or {}
            name, args = params.get("name"), params.get("arguments") or {}
            if name not in TOOLS:
                return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32602, "message": f"Unknown tool: {name}"}}
            result = call(name, args)
        else:
            return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": f"Method not found: {method}"}}
        return {"jsonrpc": "2.0", "id": mid, "result": result}
    except Exception as exc:                              # a bug here must not end the server
        log("error:", method, repr(exc))
        return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32603, "message": str(exc)[:300]}}


def call(name, args):
    fn, _, schema, _ = TOOLS[name]
    allowed = set(schema["properties"])
    unknown = set(args) - allowed
    if unknown:
        return _text(f"Unknown arguments: {', '.join(sorted(unknown))}", error=True)
    missing = [k for k in schema["required"] if k not in args]
    if missing:
        return _text(f"Missing arguments: {', '.join(missing)}", error=True)
    started = time.monotonic()
    try:
        data = fn(**args)
    except ToolError as exc:
        return _text(str(exc), error=True)
    log(name, f"{time.monotonic() - started:.2f}s")
    text = json.dumps(data, ensure_ascii=False)
    if len(text) > MAX_TEXT:
        text = text[:MAX_TEXT] + " …(cut; ask for less, e.g. a query or a section)"
    return {"content": [{"type": "text", "text": text}], "structuredContent": data, "isError": False}


def _text(message, error=False):
    return {"content": [{"type": "text", "text": message}], "isError": error}


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            reply = {"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "Parse error"}}
        else:
            reply = [r for r in map(handle, msg) if r] if isinstance(msg, list) else handle(msg)
        if reply:
            sys.stdout.write(json.dumps(reply) + "\n")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
