def _shared_entries(kind, device, action, entry, body, note, results=None):
    """0.14.0: find, get and share drivers and controllers through the registry (kimios_share.py)."""
    dev = _ask({"op": "device", "device": device})
    ds, simulated = dev["datasheet"], dev.get("simulated", False)
    if action == "find":
        return _shared(lambda sh: sh.find(ds, kind))
    if action == "get":
        if not entry:
            raise ToolError("give entry: a path from find")
        e = _shared(lambda sh: sh.get(entry, ds))
        if kind == "driver":
            test = _ask({"op": "driver_test", "device": device, "manifest": e["driver"]})
            out = {"entry": entry, "note": e.get("note"), "manifest": e["driver"], "test": test}
            out["next"] = (f"it passed on this device: promote it with driver(action='promote', manifest=…, "
                           f"note='from the registry: {entry}')" if test.get("passed") else
                           "it did not pass on this device: do not promote it; fix it or write one from the datasheet")
            return out
        check = _ask({"op": "controller_check", "device": device, "spec": e["controller"]})
        return {"entry": entry, "note": e.get("note"), "spec": e["controller"], "check": check,
                "results_elsewhere": e.get("evidence"),
                "next": "if check has no problems, start it with controller(action='start', spec=…); the guard holds "
                        "it to this device's datasheet"}
    # share: only what works here now
    if kind == "driver":
        manifest = body or dev["driver"].get("manifest")          # the given manifest, or the current version
        if not manifest:
            raise ToolError("this device has no driver to share yet")
        test = _ask({"op": "driver_test", "device": device, "manifest": manifest})
        if not test.get("passed"):
            raise ToolError("only a driver that passes its test now can be shared: "
                            + "; ".join(f"{c['what']}: {c['detail']}" for c in test["checks"] if not c["ok"]))
        evidence = {"test": "passed", "checks": len(test["checks"]), "on": "simulated" if simulated else "real device"}
    else:
        spec = body or (dev.get("status") or {}).get("controller")
        if not spec:
            raise ToolError("give the spec to share, or share while it runs")
        check = _ask({"op": "controller_check", "device": device, "spec": spec})
        if check.get("problems"):
            raise ToolError("only a controller the guard accepts can be shared: " + "; ".join(check["problems"]))
        manifest = spec
        evidence = {"check": "accepted", "on": "simulated" if simulated else "real device"}
        if isinstance(results, dict) and results:
            evidence["results"] = {str(k)[:40]: v for k, v in list(results.items())[:12]
                                   if isinstance(v, (int, float, str, bool))}
    return _shared(lambda sh: sh.prepare(sh.make_entry(kind, ds, manifest, evidence, note, simulated, VERSION)))


def tool_driver(device, action, manifest=None, version=None, note=None, entry=None):
    if action in ("find", "get", "share"):
        return _shared_entries("driver", device, action, entry, manifest, note)
    if action == "test":
        if not manifest:
            raise ToolError("give the manifest to test")
        out = _ask({"op": "driver_test", "device": device, "manifest": manifest})
        if not out["passed"]:
            out["next"] = "fix what failed and test again; promote only when every check passes"
        return out
    if action == "promote":
        return _ask({"op": "driver_promote", "device": device, "manifest": manifest, "by": "agent",
                     "note": note or ""})
    if action == "versions":
        return _ask({"op": "device", "device": device})["driver"]
    if action == "rollback":
        return _ask({"op": "driver_rollback", "device": device, "version": version})
    raise ToolError("action is test, promote, versions, rollback, find, get or share")


def _bench_csv(device, rows):
    folder = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "kimios" / "bench"
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / f"{device}-{time.strftime('%Y%m%d-%H%M%S')}.csv"
    if not rows:
        raise ToolError("the experiment gave no readings")
    t0 = rows[0]["t"]
    cols = [k for k in rows[0] if k not in ("t", "mode")]
    with path.open("w", encoding="utf-8") as f:
        f.write(",".join(["t"] + cols) + "\n")
        for r in rows:
            f.write(",".join([f"{r['t'] - t0:g}"] + ["" if r.get(c) is None else f"{r[c]:g}" for c in cols]) + "\n")
    first, last = rows[0], rows[-1]
    return {"csv_path": str(path), "columns": ["t"] + cols, "samples": len(rows),
            "seconds": round(last["t"] - t0), "start": {c: first.get(c) for c in cols},
            "end": {c: last.get(c) for c in cols},
            "next": "fit a model with control_identify(csv_path, columns={t: 't', u: <output>, y: <sensor>})"}


def tool_bench_experiment(device, steps=None, output=None, value=None, seconds=None, after_s=None, collect=False):
    if collect:
        out = _ask({"op": "experiment", "device": device, "collect": True})
    else:
        if not steps:
            if output is None or value is None or not seconds:
                raise ToolError("give steps [{set: {output: value}, seconds}], or output, value and seconds "
                                "(and after_s to keep recording with the output back off)")
            steps = [{"set": {output: value}, "seconds": seconds}]
            if after_s:
                steps.append({"set": {output: 0}, "seconds": after_s})
        out = _ask({"op": "experiment", "device": device, "steps": steps, "max_wait_s": 100}, timeout=130)
    if out.get("running"):
        return {"running": True, "next": "still running (device time runs faster than the clock on a simulated "
                                         "device): call bench_experiment(device, collect=true) in a moment"}
    return _bench_csv(device, out["rows"])


def tool_bench_event(device, event, args=None):
    return _sim_control({"device": device, "event": event, "args": args or {}})


def tool_controller(device, action, spec=None, entry=None, note=None, results=None):
    if action in ("find", "get", "share"):
        return _shared_entries("controller", device, action, entry, spec, note, results)
    if action == "check":
        return _ask({"op": "controller_check", "device": device, "spec": spec})
    if action == "start":
        out = _ask({"op": "controller_start", "device": device, "spec": spec, "by": "agent"})
        out["next"] = "watch it with bench(device): mode, readings, outputs and the guard's events"
        return out
    if action == "stop":
        return _ask({"op": "controller_stop", "device": device})
    raise ToolError("action is check, start, stop, find, get or share")


