def log(*parts):
    print("kimios-mcp:", *parts, file=sys.stderr, flush=True)


def run(cmd, timeout=20, input_text=None):
    """(returncode, stdout, stderr); never raises for a missing program or a timeout."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, input=input_text)
        return p.returncode, p.stdout, p.stderr
    except FileNotFoundError:
        return 127, "", f"{cmd[0]}: not installed"
    except subprocess.TimeoutExpired:
        return 124, "", f"{cmd[0]}: took longer than {timeout} s"


def read(path, default=None):
    try:
        return Path(path).read_text(errors="replace").strip()
    except OSError:
        return default


class ToolError(Exception):
    """A failure the agent can act on: returned as isError with this message."""


# ------------------------------------------------------------------------------------------------- machine
def tool_machine(section="summary"):
    data = None
    if HARDWARE_JSON.exists():
        try:
            data = json.loads(HARDWARE_JSON.read_text())
        except ValueError:
            data = None
    if data is None:
        code, out, err = run([HWPROBE])
        if code != 0:
            raise ToolError(f"the hardware probe could not run: {err.strip()[:200]}")
        data = json.loads(out)
    if section == "all":
        return data
    if section == "devices":
        return {"devices": data.get("devices", [])}
    if section == "unclaimed":
        return {"unclaimed": data.get("unclaimed", []),
                "note": "Devices without a driver. KimiOS Phase 3 writes drivers for these."}
    return {"machine": data.get("machine"), "capabilities": data.get("capabilities"),
            "classes": data.get("classes"), "devices": len(data.get("devices", [])),
            "unclaimed": len(data.get("unclaimed", [])), "probed_at": data.get("probed_at")}


# ------------------------------------------------------------------------------------------------- devices (Phase 3)
HWDATA = Path(os.environ.get("KIMIOS_HWDATA", "/usr/share/hwdata"))
MODULES = Path(os.environ.get("KIMIOS_MODULES", f"/lib/modules/{platform.release()}"))


def _id_name(db_file, vendor, device=None):
    """Vendor and product names from the hwdata lists (usb.ids, pci.ids)."""
    vendor, device = (vendor or "").lower().replace("0x", ""), (device or "").lower().replace("0x", "")
    vname = dname = None
    try:
        with open(db_file, encoding="utf-8", errors="replace") as f:
            in_vendor = False
            for line in f:
                if not line.strip() or line.startswith("#"):
                    continue
                if not line.startswith("\t"):
                    if in_vendor:
                        break
                    if line[:4].lower() == vendor:
                        vname, in_vendor = line[4:].strip(), True
                elif in_vendor and device and not line.startswith("\t\t") and line[1:5].lower() == device:
                    dname = line[5:].strip()
                    break
    except OSError:
        pass
    return vname, dname


def _kernel_modules_for(modaliases):
    """Kernel modules whose alias patterns match the device's modalias strings (modules.alias)."""
    found = []
    try:
        with open(MODULES / "modules.alias", encoding="utf-8", errors="replace") as f:
            for line in f:
                parts = line.split()
                if len(parts) == 3 and parts[0] == "alias" and any(fnmatch.fnmatchcase(m, parts[1]) for m in modaliases):
                    if parts[2] not in found:
                        found.append(parts[2])
    except OSError:
        pass
    return found


def tool_device_inspect(address=""):
    """Everything known about one device, and what it would take to drive it. Without an address: the devices
    that have no driver (the hardware probe's unclaimed list)."""
    if not address:
        unclaimed = tool_machine("unclaimed")["unclaimed"]
        return {"unclaimed": [{**d, **_describe(d.get("bus"), d.get("address"))} for d in unclaimed]}
    bus = "usb" if ":" not in address or "-" in address.split(":")[0] else "pci"
    return {"bus": bus, "address": address, **_describe(bus, address)}


def _describe(bus, address):
    sysfs = ROOT / f"sys/bus/{bus}/devices/{address}"
    if not sysfs.exists():
        return {"error": f"no {bus} device at {address}"}
    if bus == "usb":
        vendor, product = read(sysfs / "idVendor"), read(sysfs / "idProduct")
        interfaces = []
        for intf in sorted(sysfs.parent.glob(address + ":*")):
            drv = intf / "driver"
            interfaces.append({"class": read(intf / "bInterfaceClass"), "subclass": read(intf / "bInterfaceSubClass"),
                               "protocol": read(intf / "bInterfaceProtocol"), "modalias": read(intf / "modalias"),
                               "driver": os.path.basename(os.readlink(drv)) if drv.is_symlink() else None})
        aliases = [i["modalias"] for i in interfaces if i["modalias"]] + [m for m in [read(sysfs / "modalias")] if m]
        names = _id_name(HWDATA / "usb.ids", vendor, product)
        info = {"vendor_id": vendor, "device_id": product, "interfaces": interfaces,
                "says_it_is": " ".join(x for x in (read(sysfs / "manufacturer"), read(sysfs / "product")) if x) or None}
    else:
        vendor, product = read(sysfs / "vendor"), read(sysfs / "device")
        aliases = [m for m in [read(sysfs / "modalias")] if m]
        names = _id_name(HWDATA / "pci.ids", vendor, product)
        drv = sysfs / "driver"
        info = {"vendor_id": vendor, "device_id": product, "class": read(sysfs / "class"),
                "driver": os.path.basename(os.readlink(drv)) if drv.is_symlink() else None}
    modules = _kernel_modules_for(aliases)
    loaded = [m for m in modules if (ROOT / "sys/module" / m.replace("-", "_")).exists()]
    info.update(vendor=names[0], product=names[1], kernel_modules=modules, loaded_modules=loaded)
    info["next_step"] = _next_step(info, modules, loaded)
    return info


def _next_step(info, modules, loaded):
    label = " ".join(x for x in (info.get("vendor"), info.get("product"), info.get("says_it_is")) if x).lower()
    if modules and not loaded:
        return (f"A kernel driver exists but is not loaded: {', '.join(modules)}. An administrator can load it "
                f"with `sudo modprobe {modules[0]}`.")
    if modules:
        return "Its kernel driver is loaded; if it still does not work, the logs tool may say why."
    if "fingerprint" in label:
        return ("A fingerprint reader: Linux drives these from user space (fprintd and libfprint). Try "
                "`fprintd-list $USER`; if it is not supported, it is a candidate for KimiOS driver synthesis.")
    if info.get("class") and str(info["class"]).startswith("0x05"):
        return "A memory controller of the chipset: it needs no driver."
    return ("No driver on this computer knows it. It is a candidate for a user-space driver written by KimiOS "
            "(Phase 3): identify it, write and test a driver in a sandbox, then ask before using it.")


# ------------------------------------------------------------------------------------------------- abilities (Phase 2b)
KIMILM_DB = Path(os.environ.get("KIMIOS_KIMILM_DB", Path.home() / ".config/KimiLM/kimilm.sqlite3"))


def _kimilm_rows(sql):
    if not KIMILM_DB.exists():
        return []
    try:
        con = sqlite3.connect(f"file:{KIMILM_DB}?mode=ro", uri=True, timeout=5)
        con.row_factory = sqlite3.Row
        try:
            return [dict(r) for r in con.execute(sql)]
        finally:
            con.close()
    except sqlite3.Error as exc:
        log("kimilm database:", exc)
        return []


def _js(text, default):
    try:
        return json.loads(text) if text else default
    except ValueError:
        return default


def tool_abilities():
    """What this computer has shown it can do: measured, not guessed (KimiOS self-model, scope §2.5)."""
    status = tool_system_status()
    try:
        hw = tool_machine("summary")
    except ToolError:
        hw = {}
    models = []
    for m in _kimilm_rows("SELECT id, name, size, quant, bench_json FROM models"):
        bench = _js(m.get("bench_json"), {})
        models.append({"id": m["id"], "name": m.get("name"), "size_gb": _gb(m.get("size")), "quant": m.get("quant"),
                       "reads_per_second": bench.get("prompt_per_second"),
                       "writes_per_second": bench.get("predicted_per_second"),
                       "tuned_best": (bench.get("tune") or {}).get("best")})
    evals = {}
    for r in _kimilm_rows("SELECT model, created, version, status, summary_json FROM eval_runs "
                          "WHERE status='done' ORDER BY created"):
        s = _js(r.get("summary_json"), {})
        if s.get("total"):
            evals[r["model"]] = {"passed": s.get("passed"), "of": s.get("total"),
                                 "minutes": round((s.get("seconds") or 0) / 60), "version": r.get("version"),
                                 "when": r.get("created")}
    for m in models:
        m["evaluation"] = evals.get(m["id"])
    scored = [m for m in models if m["evaluation"]]
    best = None
    if scored:
        best = max(scored, key=lambda m: (m["evaluation"]["passed"] / m["evaluation"]["of"], -m["evaluation"]["minutes"]))
    return {
        "machine": hw.get("machine"), "capabilities": hw.get("capabilities"),
        "memory": status["memory"], "kimilm_memory": status["kimilm_memory"], "power": status["power"],
        "local_models": models,
        "best_for_agent_work": best and {"model": best["id"], **best["evaluation"]},
        "not_measured_yet": [m["id"] for m in models if not m["evaluation"]],
        "note": "Speeds are tokens per second measured by KimiLM; evaluations are KimiLM's 12-task check. "
                "A model not measured yet can be checked in KimiLM: Settings → Check this setup.",
    }


# ------------------------------------------------------------------------------------------------- status
def _meminfo(root):
    out = {}
    for line in (read(root / "proc/meminfo", "") or "").splitlines():
        k, _, v = line.partition(":")
        parts = v.split()
        if parts and parts[0].isdigit():
            out[k] = int(parts[0]) * 1024
    return out


def _gb(n):
    return None if n is None else round(n / 1024 ** 3, 2)


def _power(root):
    supplies = []
    for d in sorted((root / "sys/class/power_supply").glob("*")):
        kind = read(d / "type")
        if kind == "Battery":
            supplies.append({"name": d.name, "type": "battery", "percent": _int(read(d / "capacity")),
                             "status": read(d / "status")})
        elif kind == "Mains":
            supplies.append({"name": d.name, "type": "mains", "online": read(d / "online") == "1"})
    return supplies


def _int(v):
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def _temperatures(root):
    temps = []
    for z in sorted((root / "sys/class/thermal").glob("thermal_zone*")):
        t = _int(read(z / "temp"))
        if t is not None:
            temps.append({"zone": read(z / "type") or z.name, "celsius": round(t / 1000, 1)})
    return temps


def _network(root):
    nets = []
    for n in sorted((root / "sys/class/net").glob("*")):
        if n.name == "lo":
            continue
        nets.append({"name": n.name, "state": read(n / "operstate"), "wireless": (n / "wireless").exists()})
    return nets


def _kimilm_slice(root):
    uid = os.getuid()
    base = root / f"sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service/kimilm.slice"
    if not base.exists():
        return None

    def num(name):
        v = read(base / name)
        return None if v in (None, "max") else _int(v)
    return {"memory_gb": _gb(num("memory.current")), "high_gb": _gb(num("memory.high")), "max_gb": _gb(num("memory.max"))}


def _disks():
    out = []
    for mount in ("/", "/var", "/var/home"):
        try:
            st = os.statvfs(mount)
        except OSError:
            continue
        out.append({"mount": mount, "size_gb": _gb(st.f_blocks * st.f_frsize), "free_gb": _gb(st.f_bavail * st.f_frsize)})
    return out


def tool_system_status():
    root = ROOT
    mem = _meminfo(root)
    load = (read(root / "proc/loadavg", "") or "").split()[:3]
    uptime = (read(root / "proc/uptime", "") or "0").split()[0]
    os_release = dict(line.split("=", 1) for line in (read(root / "etc/os-release", "") or "").splitlines() if "=" in line)
    return {
        "os": os_release.get("PRETTY_NAME", "").strip('"'),
        "memory": {"total_gb": _gb(mem.get("MemTotal")), "available_gb": _gb(mem.get("MemAvailable")),
                   "swap_free_gb": _gb(mem.get("SwapFree"))},
        "kimilm_memory": _kimilm_slice(root),
        "load_average": [float(x) for x in load] if load else None,
        "cpu_threads": os.cpu_count(),
        "uptime_hours": round(float(uptime) / 3600, 1),
        "power": _power(root),
        "temperatures": _temperatures(root)[:8],
        "network": _network(root),
        "disks": _disks(),
    }


def tool_os_status():
    code, out, err = run(["rpm-ostree", "status", "--json"])
    if code != 0:
        raise ToolError(f"rpm-ostree status failed: {err.strip()[:200]}")
    data = json.loads(out)
    deps = []
    for d in data.get("deployments", []):
        deps.append({"booted": d.get("booted", False), "image": d.get("container-image-reference") or d.get("origin"),
                     "version": d.get("version"), "timestamp": d.get("timestamp"), "staged": d.get("staged", False),
                     "pinned": d.get("pinned", False)})
    return {"deployments": deps,
            "how_to_update": "Run `sudo bootc upgrade` and restart. `sudo bootc rollback` returns to the previous version."}


# ------------------------------------------------------------------------------------------------- software
def _data_dirs():
    home = Path(os.environ.get("HOME", "~")).expanduser()
    dirs = [Path(os.environ.get("XDG_DATA_HOME", home / ".local/share"))]
    dirs += [Path(p) for p in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":") if p]
    dirs += [home / ".local/share/flatpak/exports/share", Path("/var/lib/flatpak/exports/share")]
    seen, out = set(), []
    for d in dirs:
        if str(d) not in seen:
            seen.add(str(d))
            out.append(d)
    return out


def desktop_entries(dirs=None):
    """Installed applications from their desktop entries: what each one is for and what it opens."""
    apps = {}
    for d in dirs or _data_dirs():
        folder = d / "applications"
        if not folder.is_dir():
            continue
        for f in sorted(folder.rglob("*.desktop")):
            app_id = str(f.relative_to(folder)).replace("/", "-")
            if app_id in apps:
                continue                                  # the first data folder wins, as in the desktop
            cp = configparser.RawConfigParser(strict=False, interpolation=None)
            cp.optionxform = str
            try:
                cp.read(f, encoding="utf-8")
                e = cp["Desktop Entry"]
            except (configparser.Error, KeyError, UnicodeDecodeError):
                continue
            if e.get("Type", "Application") != "Application" or e.get("NoDisplay") == "true" or e.get("Hidden") == "true":
                continue
            split = lambda v: [x for x in (v or "").split(";") if x]  # noqa: E731
            apps[app_id] = {
                "id": app_id, "name": e.get("Name", app_id), "about": e.get("Comment") or e.get("GenericName") or "",
                "categories": split(e.get("Categories")), "keywords": split(e.get("Keywords")),
                "opens": split(e.get("MimeType"))[:12], "actions": split(e.get("Actions")),
                "flatpak": "flatpak" in str(f) or "X-Flatpak" in e,
            }
    return list(apps.values())


def tool_software(query="", limit=25, commands=False):
    q = (query or "").lower().strip()
    apps = desktop_entries()

    def hit(a):
        text = " ".join([a["name"], a["about"], a["id"], *a["categories"], *a["keywords"], *a["opens"]]).lower()
        return all(word in text for word in q.split())
    found = [a for a in apps if not q or hit(a)]
    result = {"apps": found[:max(1, min(int(limit or 25), 100))], "apps_total": len(apps), "matched": len(found)}
    if commands and q:
        cmds = set()
        for p in os.environ.get("PATH", "/usr/bin").split(":"):
            try:
                cmds.update(n for n in os.listdir(p) if q in n.lower() and os.access(os.path.join(p, n), os.X_OK))
            except OSError:
                pass
        result["commands"] = sorted(cmds)[:50]
    result["how_to_use"] = "launch_app with an app's id; open a file with `open` and the default app is chosen."
    return result


def tool_launch_app(app_id):
    if not app_id or "/" in app_id:
        raise ToolError("give the id of an installed app (from the software tool)")
    name = app_id[:-8] if app_id.endswith(".desktop") else app_id
    if not any(a["id"] in (app_id, name + ".desktop") for a in desktop_entries()):
        raise ToolError(f"no installed app has the id {app_id!r}; search with the software tool")
    code, _, err = run(["gtk-launch", name], timeout=15)
    if code != 0:
        raise ToolError(f"could not start {app_id}: {err.strip()[:200]}")
    return {"started": app_id}


def tool_open(target):
    if not target:
        raise ToolError("give a file, folder or web address")
    if "://" not in target and not Path(target).expanduser().exists():
        raise ToolError(f"{target} does not exist")
    code, _, err = run(["gio", "open", str(Path(target).expanduser()) if "://" not in target else target], timeout=15)
    if code != 0:
        raise ToolError(f"could not open it: {err.strip()[:200]}")
    return {"opened": target}


# ------------------------------------------------------------------------------------------------- settings
def _allowed(schema, key):
    for s, keys in SETTINGS_ALLOWED:
        if schema == s or schema.startswith(s + ":"):
            return key in keys
    return False


def tool_setting_get(schema, key):
    code, out, err = run(["gsettings", "get", schema, key])
    if code != 0:
        raise ToolError(err.strip()[:200] or "no such setting")
    return {"schema": schema, "key": key, "value": out.strip()}


def tool_setting_set(schema, key, value):
    if not _allowed(schema, key):
        allowed = "; ".join(f"{s}: {', '.join(k)}" for s, k in SETTINGS_ALLOWED)
        raise ToolError(f"{schema} {key} is not a setting agents may change. Allowed: {allowed}")
    old = tool_setting_get(schema, key)["value"]
    code, _, err = run(["gsettings", "set", schema, key, str(value)])
    if code != 0:
        raise ToolError(err.strip()[:200] or "the value was refused")
    return {"schema": schema, "key": key, "old": old, "new": tool_setting_get(schema, key)["value"],
            "undo": f"setting_set {schema} {key} {old}"}


# ------------------------------------------------------------------------------------------------- drives
def tool_drives():
    code, out, err = run(["lsblk", "-J", "-o", "PATH,LABEL,SIZE,FSTYPE,FSAVAIL,MOUNTPOINTS,TYPE,RM"])
    if code != 0:
        raise ToolError(err.strip()[:200])
    found = []

    def walk(nodes):
        for n in nodes or []:
            if n.get("type") in ("part", "crypt", "disk") and n.get("fstype"):
                mounts = [m for m in (n.get("mountpoints") or [n.get("mountpoint")]) if m]
                drive = {"device": n.get("path"), "label": n.get("label"), "size": n.get("size"),
                         "filesystem": n.get("fstype"), "mounted_at": mounts[0] if mounts else None,
                         "removable": bool(n.get("rm"))}
                if len(mounts) > 1:
                    drive["also_mounted_at"] = mounts[1:]
                if n.get("fsavail"):
                    drive["free"] = n.get("fsavail")
                if n.get("fstype") == "crypto_LUKS":
                    inner = [c.get("path") for c in n.get("children") or []]
                    drive["encrypted"] = True
                    drive["unlocked_as"] = inner[0] if inner else None
                    drive["note"] = ("encrypted container, unlocked and in use; its contents are listed as "
                                     + inner[0]) if inner else "encrypted and locked"
                found.append(drive)
            walk(n.get("children"))
    walk(json.loads(out).get("blockdevices"))
    return {"drives": found}


def tool_mount_drive(label):
    drive = next((d for d in tool_drives()["drives"] if d["label"] == label), None)
    if not drive:
        raise ToolError(f"no drive is labelled {label!r}; list them with the drives tool")
    if drive["mounted_at"]:
        return {"label": label, "mounted_at": drive["mounted_at"], "note": "already mounted"}
    code, out, err = run(["udisksctl", "mount", "-b", drive["device"]], timeout=90)
    if code != 0:
        raise ToolError(err.strip()[:200] or "could not mount it")
    return {"label": label, "result": out.strip()}


# ------------------------------------------------------------------------------------------------- logs, notify
def tool_logs(scope="user", unit="", lines=50, priority="warning"):
    lines = max(1, min(int(lines or 50), 300))
    cmd = ["journalctl", "--no-pager", "-o", "short-iso", "-n", str(lines)]
    if scope == "user":
        cmd.append("--user")
    if unit:
        cmd += ["-u", unit] if scope != "user" else ["--user-unit", unit]
    if priority:
        cmd += ["-p", priority]
    code, out, err = run(cmd, timeout=20)
    if code != 0 and not out:
        raise ToolError(err.strip()[:200])
    return {"lines": out.splitlines()[-lines:]}


def _gv(text):
    """A GVariant string literal, so gdbus never reads a title such as "true" as another type."""
    return "'" + str(text).replace("\\", "\\\\").replace("'", "\\'") + "'"


def tool_notify(title, body=""):
    code, _, err = run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                        "--object-path", "/org/freedesktop/Notifications", "--method",
                        "org.freedesktop.Notifications.Notify", _gv("KimiOS"), "0", _gv("kimilm"), _gv(title),
                        _gv(body), "[]", "{}", "-1"])
    if code != 0:
        raise ToolError(err.strip()[:200] or "no notification service")
    return {"shown": title}


# ------------------------------------------------------------------------------------------------- apps (Flatpak)
def tool_app_install(app_id):
    if not app_id or " " in app_id:
        raise ToolError("give a Flathub app id, such as org.gimp.GIMP")
    code, out, err = run(["flatpak", "install", "--user", "-y", "--noninteractive", "flathub", app_id], timeout=1800)
    if code != 0:
        raise ToolError((err or out).strip()[-400:])
    return {"installed": app_id}


def tool_app_remove(app_id):
    code, out, err = run(["flatpak", "uninstall", "--user", "-y", "--noninteractive", app_id], timeout=600)
    if code != 0:
        raise ToolError((err or out).strip()[-400:])
    return {"removed": app_id}


# ------------------------------------------------------------------------------------------------- control (Phase 4)
def _control():
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    import kimios_control
    return kimios_control


def _wrap(fn):
    def call(**args):
        ctl = _control()
        try:
            return getattr(ctl, fn)(**args)
        except ctl.ControlError as exc:
            raise ToolError(str(exc)) from None
    return call


