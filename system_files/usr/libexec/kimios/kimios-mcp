                                     "enable-animations", "font-name", "monospace-font-name")),
    ("org.gnome.desktop.background", ("picture-uri", "picture-uri-dark", "picture-options", "primary-color")),
    ("org.gnome.desktop.session", ("idle-delay",)),
    ("org.gnome.desktop.notifications", ("show-banners", "show-in-lock-screen")),
    ("org.gnome.settings-daemon.plugins.color", ("night-light-enabled", "night-light-temperature",
                                                 "night-light-schedule-automatic")),
    ("org.gnome.settings-daemon.plugins.power", ("sleep-inactive-ac-type", "sleep-inactive-battery-type",
                                                 "sleep-inactive-ac-timeout", "sleep-inactive-battery-timeout",
                                                 "power-button-action")),
    ("org.gnome.desktop.peripherals.touchpad", ("tap-to-click", "natural-scroll", "speed", "two-finger-scrolling-enabled")),
    ("org.gnome.desktop.peripherals.mouse", ("speed", "natural-scroll", "left-handed")),
    ("org.gnome.desktop.input-sources", ("sources",)),
    ("org.gnome.desktop.wm.preferences", ("button-layout",)),
