def tool_snapshot(action, id=None, path=None, paths=None, reason=None):
    K = _snap()
    try:
        if action == "take":
            return K.take(reason or "", paths or ([path] if path else None))
        if action == "list":
            rows = K.snapshots()
            return {"snapshots": [{k: m.get(k) for k in ("id", "created", "reason", "kind", "paths")} for m in rows]}
        if action == "changes":
