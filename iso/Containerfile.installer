# KimiOS installer (0.12.0; docs/SCOPE.md Phase 2): the environment the ISO boots into, Anaconda's graphical
# installer on Fedora bootc. image-builder's generic-iso turns it into an ISO and embeds KimiOS itself as the
# payload (--bootc-installer-payload-ref), so installing needs no network.
#
# Interactive, never "install to the first disk": the only default given to Anaconda is what to install
# (interactive-defaults.ks: the `bootc` line). The disk, how to divide it (alongside Windows, keeping a data
# partition) and the user are asked; tests/test_iso.py keeps it that way.
#
# Follows image-builder's reference (doc/20-advanced/20-bootc/10-isos.md, "Anaconda GTK installer"); the steps
# after the package install are what lorax normally does to make Anaconda run.
ARG FEDORA_VERSION=45
FROM quay.io/fedora/fedora-bootc:${FEDORA_VERSION}

# what the installer puts on the disk, and where `bootc upgrade` looks for new versions afterwards
ARG PAYLOAD=ghcr.io/kiplabat/kimios:latest

RUN dnf5 install -qy \
      anaconda \
      anaconda-install-img-deps \
      anaconda-dracut \
      dracut-config-generic \
      dracut-network \
      net-tools \
      grub2-efi-x64-cdboot \
      plymouth \
      default-fonts-core-sans \
      default-fonts-other-sans \
      google-noto-sans-cjk-fonts \
      xorrisofs \
      squashfs-tools \
      jq \
 && dnf5 clean all

RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# the ISO's label and boot menu (files/: no heredocs, the build runner's podman does not read them)
COPY files/iso.yaml /usr/lib/image-builder/bootc/iso.yaml

# what to install: KimiOS from the copy inside the ISO; updates from the registry. Nothing else: Anaconda asks
RUN mkdir -p /usr/share/anaconda && \
    echo "bootc --source-imgref containers-storage:${PAYLOAD} --target-imgref ${PAYLOAD}" \
      > /usr/share/anaconda/interactive-defaults.ks

# make Anaconda the system's program (normally lorax's job)
RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd && \
    echo "install::14438:0:99999:7:::" >> /etc/shadow && \
    passwd -d root

RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    mkdir -p /etc/anaconda.repos.d && \
    for d in /etc/yum.repos.d /usr/share/dnf5/repos.d; do \
      if [ -d "$d" ]; then cp -a "$d"/. /etc/anaconda.repos.d/ && rm -rf "$d"; fi; \
    done && \
    ln -sf /lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -fv /usr/lib/systemd/system-generators/systemd-gpt-auto-generator

RUN ln -s /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service

COPY files/anaconda-shell.conf /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

RUN mkdir -p "$(realpath /root)" && \
    kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version') && \
    DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
      --add "anaconda" "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"

COPY files/allowroot.conf /etc/systemd/user/pipewire.service.d/allowroot.conf
COPY files/allowroot.conf /etc/systemd/user/pipewire.socket.d/allowroot.conf
